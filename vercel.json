{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": [
        "index.html",
        "styles.css",
        "js/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index?__path=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index?__site_path=$1"
    }
  ]
}
